{
  "schemaVersion": 1,
  "id": "gazetteer",
  "version": "${version}",
  "name": "Gazetteer",
  "description": "Coordinate List (Gazetteer for short) is a simple minimalistic fabric mod for saving your coordinates. No minimaps. Just a list with in-game waypoints.",
  "authors": [
    "PouekDEV"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/gazetteer",
    "sources": "https://github.com/PouekDEV/Gazetteer",
    "issues": "https://github.com/PouekDEV/Gazetteer/issues"
  },
  "license": "MIT License",
  "icon": "assets/gazetteer/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.coredex.gazetteer.Gazetteer"
    ],
    "client": [
      "com.coredex.gazetteer.GazetteerClient"
    ]
  },
  "mixins": [
    "gazetteer.mixins.json"
  ],
  "accessWidener": "gazetteer.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.2",
    "fabric-api": "*",
    "minecraft": "~26.3-",
    "java": ">=25",
    "midnightlib": ">=1.9.2"
  },
  "suggests": {
    "another-mod": "*"
  }
}
